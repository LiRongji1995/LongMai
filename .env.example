APP_ENV=development
LOG_LEVEL=INFO

PAPER_TRADING_ENABLED=false
LIVE_TRADING_ENABLED=false
LIVE_ORDER_SUBMISSION_ALLOWED=false

ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_API_SECRET=

DATABASE_URL=postgresql://quant:quant@localhost:5432/quant
DATA_ROOT=./data
REPORT_ROOT=./artifacts/reports

# External LEAN infrastructure is intentionally discovered at runtime. Do not
# commit machine-specific paths here or enable any broker integration.
LEAN_SOURCE_ROOT=
LEAN_DOTNET_ROOT=
LEAN_DATA_ROOT=
LEAN_RESULTS_ROOT=
