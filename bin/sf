#!/bin/sh
# Wrapper for the `sf` CLI. Uses ../stockfish-env next to the checkout unless SF_PYTHON is set.
# SF_CWD keeps the caller's directory so relative file arguments still work after the cd.
HERE="$(cd "$(dirname "$0")/.." && pwd)"
PY="${SF_PYTHON:-$HERE/../stockfish-env/bin/python}"
SF_CWD="${SF_CWD:-$PWD}"
export SF_CWD
cd "$HERE/stock-fish" && exec "$PY" -m sf "$@"
