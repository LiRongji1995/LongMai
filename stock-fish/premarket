#!/bin/sh
# Local R2 workflow. The operator chooses an existing project interpreter.
set -eu
task_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
task_python=${STOCKFISH_PYTHON:-}
if [ -z "$task_python" ]; then
    task_python_file=${STOCKFISH_PREMARKET_PYTHON_FILE:-"$task_root/reports/premarket-runtime/python.path"}
    if [ -f "$task_python_file" ]; then
        IFS= read -r task_python < "$task_python_file" || [ -n "$task_python" ]
    elif [ -x "$task_root/.venv/bin/python" ]; then
        task_python="$task_root/.venv/bin/python"
    fi
fi
if [ -z "$task_python" ] || [ ! -x "$task_python" ]; then
    printf '%s\n' '请用 STOCKFISH_PYTHON 指定现有项目Python，或配置 reports/premarket-runtime/python.path。' >&2
    exit 3
fi
exec "$task_python" -B "$task_root/scripts/stockfish.py" premarket "$@"
