# Copy to stock-fish/.env. Edit absolute paths to match your checkout root.
# Quant inference works without LLM credentials.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=
TUSHARE_TOKEN=
ZEP_API_KEY=
TAVILY_API_KEY=

HOST=127.0.0.1
PORT=8000
DEBUG=False
STOCK_BACKEND=advanced
MIROFISH_HOST=127.0.0.1
MIROFISH_PORT=5001
SEARXNG_PUBLIC_INSTANCES_ENABLED=false

QLIB_EXECUTION_MODE=native
QLIB_DATA_DIR=D:/StockRecommendation/data/cn_data
QLIB_HOST_DATA_DIR=D:/StockRecommendation/data
QLIB_HOST_MLRUNS_DIR=D:/StockRecommendation/stock-fish/qlib-zh/mlruns
QLIB_KERNELS=1
# Optional proxy: set locally only if required by your network.
QLIB_DATA_PROXY=
PYTHONUTF8=1

# Create these local directories before starting; update all paths for another root.
TEMP=D:/StockRecommendation/work/tmp
TMP=D:/StockRecommendation/work/tmp
XDG_CACHE_HOME=D:/StockRecommendation/downloads/cache
MPLCONFIGDIR=D:/StockRecommendation/downloads/cache/matplotlib
HF_HOME=D:/StockRecommendation/downloads/cache/huggingface
MLFLOW_DISABLE_AGENT_HINT=1

EFINANCE_CALL_TIMEOUT=5
EFINANCE_PRIORITY=5
YFINANCE_PRIORITY=0
PYTDX_PRIORITY=2
AKSHARE_PRIORITY=4
BAOSTOCK_PRIORITY=3
REALTIME_SOURCE_PRIORITY=tencent,tushare,efinance,akshare_em
